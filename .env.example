# Copy this file to .env and fill in your own values. Never commit .env.

# LLM endpoint (default: local Ollama, OpenAI-compatible API)
LLM_BASE_URL=http://localhost:11434/v1
# Local Ollama accepts any non-empty value; use the real key for the FBK server / OpenAI
LLM_API_KEY=replace-me

# Number of jobs processed in parallel
K_CONSUMERS=2
